{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oceanbench.edito.eu/schemas/scores-v1.schema.json",
  "title": "OceanBench scores file, version 1",
  "description": "Scores of one challenger on one region, written by `oceanbench evaluate` as <challenger>.<region>.scores.json.",
  "type": "object",
  "required": [
    "schema_version",
    "oceanbench_version",
    "challenger",
    "region",
    "start_dates",
    "lead_days_count",
    "challenger_code",
    "created_at",
    "timings",
    "rows"
  ],
  "properties": {
    "schema_version": {
      "description": "Version of this schema. Incremented on any change that breaks a reader of the previous version.",
      "const": 1
    },
    "oceanbench_version": {"type": "string", "minLength": 1},
    "challenger": {"type": "string", "minLength": 1},
    "region": {
      "type": "object",
      "required": ["id", "display_name", "official", "bounds"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "display_name": {"type": "string"},
        "official": {"type": "boolean"},
        "bounds": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["minimum_latitude", "maximum_latitude", "minimum_longitude", "maximum_longitude"],
              "properties": {
                "minimum_latitude": {"type": "number"},
                "maximum_latitude": {"type": "number"},
                "minimum_longitude": {"type": "number"},
                "maximum_longitude": {"type": "number"}
              }
            }
          ]
        }
      }
    },
    "start_dates": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
    },
    "lead_days_count": {"type": "integer", "minimum": 1},
    "challenger_code": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "timings": {"type": "object", "additionalProperties": {"type": "number"}},
    "rows": {"type": "array", "items": {"$ref": "#/$defs/row"}}
  },
  "$defs": {
    "row": {
      "type": "object",
      "required": ["metric", "reference", "variable", "standard_name", "depth", "unit", "lead_day", "value"],
      "properties": {
        "metric": {
          "enum": [
            "rmsd_of_variables",
            "rmsd_of_mixed_layer_depth",
            "rmsd_of_geostrophic_currents",
            "deviation_of_lagrangian_trajectories"
          ]
        },
        "reference": {"enum": ["glorys_reanalysis", "glo12_analysis", "observations"]},
        "variable": {"type": "string", "minLength": 1},
        "standard_name": {"type": ["string", "null"]},
        "depth": {"type": "string", "minLength": 1},
        "unit": {"type": "string"},
        "lead_day": {"type": "integer", "minimum": 1},
        "value": {"type": ["number", "null"]},
        "missing_fraction": {"type": ["number", "null"]},
        "observations": {"type": ["integer", "null"]},
        "missing": {"type": ["integer", "null"]}
      }
    }
  }
}
